# Для Apache (типовий спільний хостинг). На nginx цей файл ігнорується — див. deploy/nginx.conf.
AddDefaultCharset utf-8
DirectoryIndex index.html
ErrorDocument 404 /404.html


<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|avif|webp|jpe?g|png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>
