---
import { Image } from 'astro:assets';
import emblem from '../assets/emblem.webp';
import { NAV, T, url, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang];
const year = new Date().getFullYear();
---
<footer class="footer">
  <svg class="smith footer__smith" aria-hidden="true"></svg>
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <Image src={emblem} width={192} height={192} alt={lang === 'uk' ? 'Емблема кафедри комп’ютерної інженерії' : 'Emblem of the Department of Computer Engineering'} loading="lazy" />
        <p class="footer__about">{t.footNote}<br />{t.uni}</p>
      </div>
      <nav class="footer__nav" aria-label={t.sections}>
        <h2 class="h3f">{t.sections}</h2>
        <ul>
          {NAV.map(n => <li><a href={url(lang, n.path)}>{n[lang]}</a></li>)}
          <li><a href={url(lang, '/studying/')}>{t.studying}</a></li>
        </ul>
      </nav>
      <div>
        <h2 class="h3f">{t.contacts}</h2>
        <address>
          <a href="mailto:ce.frecs@knu.ua">ce.frecs@knu.ua</a>
          <span>{t.address}</span>
          <a href="https://rex.knu.ua/" rel="noopener" target="_blank">{lang === 'uk' ? 'Факультет РЕКС' : 'Faculty website'}</a>
          <a href={url(lang, '/rss.xml')}>{t.rss}</a>
        </address>
      </div>
    </div>
    <div class="footer__bot">
      <span>© {year} · {t.dept}</span>
      <span>{t.made} · <a href={url(lang, '/sitemap-index.xml').replace('/en/', '/')}>{t.sitemap}</a></span>
    </div>
  </div>
  <canvas class="footer__rex" data-rex="cap" width="90" height="72" aria-hidden="true"></canvas>
</footer>
