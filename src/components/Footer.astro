---
import { NAV, T, url, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang];
const year = new Date().getFullYear();
const brand = `${import.meta.env.BASE_URL}brand/`;
---
<footer class="footer">
  <svg class="smith footer__smith" aria-hidden="true"></svg>
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__brand">
        <picture>
          <source media="(max-width: 860px)" srcset={brand + 'seal-compact.svg'} />
          <img src={brand + 'seal.svg'} width="88" height="88" alt={lang === 'uk' ? 'Герб кафедри комп’ютерної інженерії' : 'Seal of the Department of Computer Engineering'} loading="lazy" />
        </picture>
        <p class="footer__about">{t.footNote.split(' · ')[0]}<span class="footer__aff">{t.footNote.split(' · ').slice(1).join(' · ')}</span>{t.uni}</p>
      </div>
      <nav class="footer__nav" aria-label={t.sections}>
        <h2 class="h3f">{t.sections}</h2>
        <ul>
          {NAV.map(n => <li><a href={url(lang, n.path)}>{n[lang]}</a></li>)}
          <li><a href={url(lang, '/studying/')}>{t.studying}</a></li>
        </ul>
      </nav>
      <div>
        <h2 class="h3f">{t.contacts}</h2>
        <address>
          <a href="mailto:ce.frecs@knu.ua">ce.frecs@knu.ua</a>
          <span>{t.address}</span>
          <a href="https://rex.knu.ua/" rel="noopener" target="_blank">{lang === 'uk' ? 'Факультет РЕКС' : 'Faculty website'}</a>
          <a href={url(lang, '/rss.xml')}>{t.rss}</a>
        </address>
      </div>
    </div>
    <div class="footer__bot">
      <span>© {year} · {t.dept} · <a href={url(lang, '/sitemap/')}>{t.sitemap}</a></span>
      <span class="footer__credit"><span class="footer__made">{t.made}</span> <a href="https://www.linkedin.com/in/zakharov-ihor/" rel="noopener" target="_blank">ZakharovLabs</a></span>
    </div>
  </div>
  <canvas class="footer__rex" data-rex="cap" width="90" height="72" aria-hidden="true"></canvas>
</footer>
