---
import { Image } from 'astro:assets';
import emblem from '../assets/emblem.webp';
import ThemeToggle from './ThemeToggle.astro';
import { NAV, T, url, type Lang } from '../lib/i18n';
interface Props { lang: Lang; path: string; alt: string }
const { lang, path, alt } = Astro.props;
const t = T[lang];
const other: Lang = lang === 'uk' ? 'en' : 'uk';
const isCur = (p: string) => path === p || path.startsWith(p);
const MENU = [...NAV, { path: '/studying/', uk: 'Навчання', en: 'Studies', ch: 'STUD' }];
// синусоїда під пунктом меню: два періоди, нормована довжина для прокреслення
const wave = 'M0 3 C1.5 0 3.5 0 5 3 S8.5 6 10 3 S13.5 0 15 3 S18.5 6 20 3';
---
<header class="hd">
  <div class="wrap hd__in">
    <a class="brand" href={url(lang, '/')}>
      <Image src={emblem} width={84} height={84} alt="" loading="eager" />
      <span class="brand__t"><b>{t.deptShort}</b><small>{lang === 'uk' ? 'КНУ · ФРЕКС · Кафедра' : 'KNU · FRECS · Department'}</small></span>
    </a>
    <nav class="nav" aria-label={lang === 'uk' ? 'Основна навігація' : 'Main navigation'}>
      <ul>
        {NAV.map(n => (
          <li><a href={url(lang, n.path)} aria-current={isCur(n.path) ? 'page' : undefined} title={'title' in n ? n.title[lang] : undefined}>
            <i class="led" aria-hidden="true"></i>{n[lang]}
            <svg class="nav__wave" viewBox="0 0 20 6" preserveAspectRatio="none" aria-hidden="true"><path d={wave} pathLength="1"/></svg>
          </a></li>
        ))}
      </ul>
      <span class="nav__lens ink" aria-hidden="true"></span>
    </nav>
    <div class="tools">
      <button type="button" class="btn btn--ghost btn--icon search-btn" data-search aria-label={t.search} title={`${t.search} (/)`}><svg width="20" height="20" aria-hidden="true"><use href="#i-search"/></svg></button>
      <a class="lang-link" href={alt} hreflang={other} lang={other} title={t.switchLang}><span aria-hidden="true">{t.otherShort}</span><span class="sr-only">{t.switchLang}</span></a>
      <ThemeToggle label={t.themeDark} id="moon-hd" />
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="menu"><span class="menu-btn__t">{t.menu}</span><span class="burger" aria-hidden="true"></span><span class="sr-only">{lang === 'uk' ? ' — відкрити' : ' — open'}</span></button>
    </div>
  </div>
</header>

<div class="sheet-menu" id="menu" hidden role="dialog" aria-modal="true" aria-label={t.menu}>
  <div class="wrap sheet-menu__top">
    <a class="brand" href={url(lang, '/')}><Image src={emblem} width={84} height={84} alt="" /><span class="brand__t"><b>{t.deptShort}</b><small>{t.uniShort}</small></span></a>
    <button type="button" class="menu-btn sheet-menu__close" aria-expanded="true" aria-controls="menu"><span class="menu-btn__t">{t.close}</span><span class="burger" aria-hidden="true"></span></button>
  </div>
  <nav class="wrap" aria-label={lang === 'uk' ? 'Меню розділів' : 'Sections menu'}>
    <ul class="sheet-menu__list">
      {MENU.map((n, i) => (
        <li style={`--i:${i}`}><a href={url(lang, n.path)} aria-current={isCur(n.path) ? 'page' : undefined}>
          <span class="no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="t">{n[lang]}</span><span class="ch" aria-hidden="true">{n.ch}</span>
        </a></li>
      ))}
    </ul>
  </nav>
  <div class="wrap sheet-menu__foot">
    <a class="lang-link" href={alt} hreflang={other} lang={other}>{t.other}</a>
    <button type="button" class="btn btn--line btn--sm" data-search><svg width="18" height="18" aria-hidden="true"><use href="#i-search"/></svg>{t.search}</button>
    <ThemeToggle label={t.themeDark} id="moon-menu" cls="btn btn--line btn--icon" />
    <span class="sp"></span>
    <canvas class="sheet-menu__rex" data-rex="headset" width="90" height="72" aria-hidden="true"></canvas>
  </div>
</div>
