---
// Сторінка-перенаправлення зі старої англійської адреси (/en/entrant/ → /en/admission/), як public/news/index-N.html:
// без індексації й пошуку, працює і на GitHub Pages, і на Apache — налаштування сервера не потрібні.
interface Props { to: string; label: string }
const { to, label } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <title>Redirect</title>
  <meta http-equiv="refresh" content={`0; url=${to}`} />
  <link rel="canonical" href={new URL(to, Astro.site).href} />
</head>
<body data-pagefind-ignore="all"><p><a href={to}>{label}</a></p></body>
</html>
