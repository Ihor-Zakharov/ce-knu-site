---
// Ілюстрація КІ-Рекса з чинного сайту — компактним «підписом» наприкінці сторінки, а не окремою колонкою
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src?: ImageMetadata; alt?: string }
const { src, alt = '' } = Astro.props;
---
{src && <figure class="rex-sign"><Image src={src} alt={alt} widths={[72, 144]} sizes="72px" /><figcaption>{alt}</figcaption></figure>}
