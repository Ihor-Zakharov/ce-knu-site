---
// Заставка для новини без фото: на графіконі — одне з радіофізичних «явищ» кіту, вибране за назвою новини:
// фігура Ліссажу, тесеракт, стрічка Мебіуса, діаграма Сміта, діаграма спрямованості решітки, ряд Фур'є, інтерференція.
// Усе рахується під час збирання — статичний SVG, без JS; при наведенні промінь прокреслюється.
interface Props { slug: string; small?: boolean }
const { slug, small = false } = Astro.props;
let h = 7; for (const ch of slug) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const rnd = (k: number) => ((h >>> (k % 24)) % 1000) / 1000;
const TAU = Math.PI * 2, CX = 150, CY = 100;
const f = (n: number) => n.toFixed(1);
const poly = (pts: [number, number][]) => 'M' + pts.map(([x, y]) => `${f(x)} ${f(y)}`).join(' L');

const KINDS = ['liss', 'tess', 'mobius', 'smith', 'array', 'fourier', 'field'] as const;
const kind = KINDS[h % KINDS.length];
let main = '', faint: string[] = [], dots: [number, number][] = [];

if (kind === 'liss') {
  const R = [[3, 2], [5, 4], [3, 4], [2, 3], [4, 5], [5, 6], [4, 3]][h % 7], ph = rnd(3) * Math.PI;
  main = poly(Array.from({ length: 501 }, (_, i) => { const s = i / 500 * TAU; return [CX + 68 * Math.sin(R[0] * s + ph), CY + 68 * Math.sin(R[1] * s)]; }));
}
if (kind === 'tess') {
  const V = Array.from({ length: 16 }, (_, i) => [i & 1 ? 1 : -1, i & 2 ? 1 : -1, i & 4 ? 1 : -1, i & 8 ? 1 : -1]);
  const a = .5 + rnd(2), b = .3 + rnd(5) * .5;
  const P = V.map(p => {
    let [x, y, z, w] = p;
    [x, w] = [x * Math.cos(a) - w * Math.sin(a), x * Math.sin(a) + w * Math.cos(a)];
    [y, z] = [y * Math.cos(b) - z * Math.sin(b), y * Math.sin(b) + z * Math.cos(b)];
    const k = 1 / (2.6 - w); x *= k; y *= k; z *= k;
    const A = .55, x2 = x * Math.cos(A) - z * Math.sin(A), z2 = x * Math.sin(A) + z * Math.cos(A), s = 120 / (2.4 - z2);
    return [CX + x2 * s, CY + y * s] as [number, number];
  });
  for (let i = 0; i < 16; i++) for (let k = 0; k < 4; k++) { const j = i ^ (1 << k); if (j > i) (k === 3 ? (main += `M${f(P[i][0])} ${f(P[i][1])} L${f(P[j][0])} ${f(P[j][1])} `) : faint.push(`M${f(P[i][0])} ${f(P[i][1])} L${f(P[j][0])} ${f(P[j][1])}`)); }
  dots = P;
}
if (kind === 'mobius') {
  const Pm = (u: number, v: number) => { const r = 1 + v / 2 * Math.cos(u / 2); return [r * Math.cos(u), r * Math.sin(u), v / 2 * Math.sin(u / 2)]; };
  const yaw = .6 + rnd(4), pitch = .55;
  const pr = ([x, y, z]: number[]): [number, number] => { const X = x * Math.cos(yaw) - y * Math.sin(yaw), Y = x * Math.sin(yaw) + y * Math.cos(yaw); const Z2 = Y * Math.sin(pitch) + z * Math.cos(pitch), Y2 = Y * Math.cos(pitch) - z * Math.sin(pitch); const s = 56 / (1 + Y2 * .18); return [CX + X * s, CY - Z2 * s * 1.05]; };
  for (let i = 0; i < 64; i++) { const u = i / 64 * TAU, p = pr(Pm(u, -1)), q = pr(Pm(u, 1)); faint.push(`M${f(p[0])} ${f(p[1])} L${f(q[0])} ${f(q[1])}`); }
  main = poly(Array.from({ length: 321 }, (_, i) => pr(Pm(i / 160 * TAU, 1))));
}
if (kind === 'smith') {
  const R = 76;
  faint = [0, .2, .5, 1, 2, 5].map(r => `M${f(CX + R * (r - 1) / (1 + r))} ${CY} a${f(R / (1 + r))} ${f(R / (1 + r))} 0 1 0 ${f(2 * R / (1 + r))} 0 a${f(R / (1 + r))} ${f(R / (1 + r))} 0 1 0 ${f(-2 * R / (1 + r))} 0`);
  faint.push(`M${CX - R} ${CY} H${CX + R}`);
  const z0 = [.4 + rnd(1) * 3, (rnd(6) - .5) * 4];
  main = poly(Array.from({ length: 121 }, (_, i) => { const u = i / 120, e = 1 - Math.pow(1 - u, 3); const r = z0[0] + (1 - z0[0]) * e, x = z0[1] * (1 - e) * Math.cos(u * 9); const d = (r + 1) ** 2 + x * x; return [CX + R * (r * r + x * x - 1) / d, CY - R * 2 * x / d]; }));
  dots = [[CX, CY]];
}
if (kind === 'array') {
  const N = 8, th = (rnd(2) - .5) * 1.2, by = 176, R = 150;
  main = poly(Array.from({ length: 181 }, (_, a) => { const phi = a / 180 * Math.PI, psi = Math.PI * (Math.cos(phi) - Math.sin(th)), den = N * Math.sin(psi / 2), af = Math.abs(den) < 1e-6 ? 1 : Math.abs(Math.sin(N * psi / 2) / den); return [CX + Math.cos(phi) * af * R, by - Math.sin(phi) * af * R]; })) + ' Z';
  for (let k = 1; k <= 4; k++) faint.push(`M${CX - k * 36} ${by} A${k * 36} ${k * 36} 0 0 1 ${CX + k * 36} ${by}`);
  faint.push(`M10 ${by} H290`);
  dots = Array.from({ length: N }, (_, e) => [CX + (e - (N - 1) / 2) * 16, by]);
}
if (kind === 'fourier') {
  const N = 3 + (h % 4), per = 300 / 2.2;
  for (let k = 1; k <= 2 * N - 1; k += 2) faint.push(poly(Array.from({ length: 151 }, (_, i) => { const x = i * 2; return [x, CY - 52 * 4 / Math.PI * Math.sin(k * TAU * x / per) / k]; })));
  main = poly(Array.from({ length: 301 }, (_, x) => { let y = 0; for (let k = 1; k <= 2 * N - 1; k += 2) y += Math.sin(k * TAU * x / per) / k; return [x, CY - 52 * 4 / Math.PI * y]; }));
}
if (kind === 'field') {
  const s1 = [110, 100], s2 = [190 + rnd(3) * 20, 100];
  for (const [sx, sy] of [s1, s2]) for (let r = 14; r < 170; r += 14) faint.push(`M${sx - r} ${sy} a${r} ${r} 0 1 0 ${2 * r} 0 a${r} ${r} 0 1 0 ${-2 * r} 0`);
  main = poly(Array.from({ length: 301 }, (_, x) => [x, CY + 30 * Math.cos(TAU * Math.hypot(x - s1[0], 0) / 28) * Math.cos(TAU * Math.hypot(x - s2[0], 0) / 28) * Math.exp(-Math.abs(x - 150) / 140)]));
  dots = [s1 as [number, number], s2 as [number, number]];
}
---
<svg class:list={['news-art', `news-art--${kind}`, small && 'news-art--sm']} viewBox="0 0 300 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <g class="news-art__grat">{[1, 2, 3, 4, 5].map(i => <path d={`M${i * 50} 0V200`} />)}{[1, 2, 3].map(i => <path d={`M0 ${i * 50}H300`} />)}</g>
  {faint.map(d => <path class="news-art__faint" d={d} />)}
  <path class="news-art__trace" d={main} />
  {dots.map(([x, y]) => <circle class="news-art__dot" cx={f(x)} cy={f(y)} r={small ? 3 : 2} />)}
</svg>
