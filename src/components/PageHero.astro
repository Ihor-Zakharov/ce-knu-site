---
// Герой розділу — компактний: ланцюжок, назва, що піднімається по словах, один рядок підзаголовка.
// Прилад з КІ-Рексом — окремо (Instrument.astro), у правій колонці поруч зі змістом.
import { HEROES } from '../lib/heroes';
import { T, url, type Lang } from '../lib/i18n';
import Instrument from './Instrument.astro';
interface Props { lang: Lang; title: string; kind: string; crumbs?: { href: string; label: string }[]; meta?: string[]; text?: string; data?: Record<string, string> }
const { lang, title, kind, crumbs = [], meta = [], text = '', data = {} } = Astro.props;
const h = HEROES[kind];
const words = title.split(/\s+/);
---
<section class="ph ph--compact">
  <div class="wrap ph__grid">
    <div class="ph__text">
      <nav aria-label={lang === 'uk' ? 'Навігаційний ланцюжок' : 'Breadcrumbs'}>
        <ol class="crumbs">
          <li><a href={url(lang, '/')}>{T[lang].home}</a></li>
          {crumbs.map(c => <li><a href={c.href}>{c.label}</a></li>)}
          <li aria-current="page">{title.length > 48 ? title.slice(0, title.lastIndexOf(' ', 46)) + '…' : title}</li>
        </ol>
      </nav>
      <p class="ph__eyebrow"><b>{h.ch.split(' · ')[0]}</b>{h.ch.split(' · ')[1]}</p>
      <h1>{words.map((w, i) => <><span class="w"><span style={`--i:${i}`}>{w}</span></span>{i < words.length - 1 ? ' ' : ''}</>)}</h1>
      <p class="lead">{h.lead[lang]}</p>
      {meta.length > 0 && <p class="ph__meta">{meta.map(m => <span class="cap" set:html={m} />)}</p>}
    </div>
    <Instrument lang={lang} kind={kind} text={text} data={data} />
  </div>
</section>
