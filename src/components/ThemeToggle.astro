---
// Перемикач теми: сонце ховає промені й стає місяцем; підпис оновлює site.js
interface Props { label: string; id: string; cls?: string }
const { label, id, cls = 'btn btn--ghost btn--icon' } = Astro.props;
---
<button type="button" class:list={[cls, 'theme-toggle']} aria-label={label} title={label} aria-pressed="false">
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <mask id={id}><rect width="24" height="24" fill="#fff"/><circle class="moon-mask" cx="30" cy="-6" r="7" fill="#000"/></mask>
    <circle class="sun-core" cx="12" cy="12" r="4.6" fill="currentColor" mask={`url(#${id})`}/>
    <g class="rays" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M12 1.8v2.4M12 19.8v2.4M1.8 12h2.4M19.8 12h2.4M4.8 4.8l1.7 1.7M17.5 17.5l1.7 1.7M4.8 19.2l1.7-1.7M17.5 6.5l1.7-1.7"/></g>
  </svg>
</button>
