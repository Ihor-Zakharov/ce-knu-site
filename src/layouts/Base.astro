---
import '../styles/tokens.css';
import '../styles/kit.css';
import '../styles/site.css';
import fixel from '../assets/fonts/FixelVariable.woff2?url';
import Icons from '../components/Icons.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { T, url, stripLang, type Lang } from '../lib/i18n';

interface Props { lang: Lang; title: string; description?: string; image?: string; type?: 'website' | 'article'; noindex?: boolean }
const { lang, title, description = '', image, type = 'website', noindex = false } = Astro.props;
const t = T[lang];
const path = stripLang(Astro.url.pathname);
const other: Lang = lang === 'uk' ? 'en' : 'uk';
const alt = url(other, path);
const canonical = new URL(url(lang, path), Astro.site).href;
const full = title === t.dept ? `${t.dept} · ${t.uniShort}` : `${title} · ${t.dept}`;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang={lang} data-base={base}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description || t.footNote} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={lang === 'uk' ? 'uk' : 'en'} href={canonical} />
  <link rel="alternate" hreflang={other === 'uk' ? 'uk' : 'en'} href={new URL(alt, Astro.site).href} />
  <link rel="alternate" hreflang="x-default" href={new URL(url('uk', path), Astro.site).href} />
  <link rel="alternate" type="application/rss+xml" title={`${t.news} · ${t.dept}`} href={url(lang, '/rss.xml')} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description || t.footNote} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === 'uk' ? 'uk_UA' : 'en_US'} />
  <meta property="og:site_name" content={t.dept} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="theme-color" content="#F6F2EA" />
  <link rel="icon" href={`${base}favicon.png`} type="image/png" />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  <link rel="preload" href={fixel} as="font" type="font/woff2" crossorigin />
  <script is:inline>
    // тема до першого кадру — без спалаху; ?theme=dark|light для перевірок
    (function () {
      var q = new URLSearchParams(location.search).get('theme'), s = null;
      try { s = localStorage.getItem('ki-theme'); } catch (e) {}
      var v = q === 'dark' || q === 'light' ? q : s;
      if (v === 'dark' || v === 'light') document.documentElement.dataset.theme = v;
      var dark = v ? v === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.querySelector('meta[name="theme-color"]').content = dark ? '#141211' : '#F6F2EA';
    })();
  </script>
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <Icons />
  <Header lang={lang} path={path} alt={alt} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer lang={lang} />

  <dialog class="dlg search-dlg" id="search" aria-label={t.search}>
    <div class="dlg__card">
      <div class="dlg__in">
        <svg width="20" height="20" aria-hidden="true"><use href="#i-search"/></svg>
        <input type="search" role="combobox" aria-expanded="true" aria-controls="search-list" aria-autocomplete="list" aria-label={t.search} placeholder={t.searchPh} autocomplete="off" />
        <button type="button" class="btn btn--ghost btn--icon btn--sm" onclick="this.closest('dialog').close()" aria-label={t.close} title={t.close}><svg width="18" height="18" aria-hidden="true"><use href="#i-close"/></svg></button>
      </div>
      <ul id="search-list" role="listbox" aria-label={t.search}></ul>
      <p class="dlg__empty">{t.searchHint}</p>
      <div class="dlg__foot"><span><span class="kbd">↑↓</span> {lang === 'uk' ? 'вибір' : 'select'}</span><span><span class="kbd">Enter</span> {lang === 'uk' ? 'відкрити' : 'open'}</span><span><span class="kbd">Esc</span> {t.close.toLowerCase()}</span><span><span class="kbd">/</span> {lang === 'uk' ? 'пошук з будь-якої сторінки' : 'search from any page'}</span></div>
    </div>
  </dialog>

  <dialog class="lightbox" id="lightbox" aria-label={t.photo}>
    <div class="lightbox__in">
      <img src="data:image/gif;base64,R0lGODlhAQABAAAAACwAAAAAAQABAAA=" alt="" />
      <div class="lightbox__bar">
        <button type="button" class="btn btn--line btn--icon" data-lb-prev aria-label={t.lightboxPrev} title={t.lightboxPrev}><svg width="20" height="20" aria-hidden="true"><use href="#i-left"/></svg></button>
        <span class="cap" data-lb-cap></span>
        <button type="button" class="btn btn--line btn--icon" data-lb-next aria-label={t.lightboxNext} title={t.lightboxNext}><svg width="20" height="20" aria-hidden="true"><use href="#i-right"/></svg></button>
        <button type="button" class="btn btn--line btn--icon" data-lb-close aria-label={t.lightboxClose} title={t.lightboxClose}><svg width="20" height="20" aria-hidden="true"><use href="#i-close"/></svg></button>
      </div>
    </div>
  </dialog>
  <script>import '../scripts/site.js';</script>
</body>
</html>
