---
import Base from '../layouts/Base.astro';
import { T, url } from '../lib/i18n';
const t = T.uk, e = T.en;
---
<Base lang="uk" title={t.notFound} noindex>
  <section class="ph nf">
    <div class="wrap">
      <p class="ph__eyebrow"><b>404</b>NO SIGNAL</p>
      <h1>{t.notFound}</h1>
      <p class="lead">{t.notFoundLead}</p>
      <p class="lead" lang="en" style="font-size:15px">{e.notFound}. {e.notFoundLead}</p>
      <div class="runner" id="runner" role="application" aria-label="Гра з КІ-Рексом. Стрибок: пробіл або дотик. Пригнутися: стрілка вниз. Пауза: P">
        <canvas aria-hidden="true"></canvas>
        <span class="sr-only" data-runner-live aria-live="polite"></span>
      </div>
      <div class="row mt-m"><a class="btn" href={url('uk', '/')}>{t.toHome}</a><a class="btn btn--line" href={url('en', '/')} lang="en">{e.toHome} (EN)</a></div>
    </div>
  </section>
  <script>
    import { runner } from '../scripts/runner.js';
    const el = document.getElementById('runner');
    // рядки гри: keys і touch — рядок керування на екрані, tips — слова підказок; решта — оголошення для екранного читача
    if (el) runner(el, {
      keys: 'Керування: стрілки вгору і вниз', touch: 'Керування: торкання або утримання',
      tips: { jump: 'Стрибок', duck: 'Пригнутися', pad: 'Пружина', orb: 'Ще стрибок' },
      start: 'Гра', paused: 'Пауза', victory: 'Перемога', seasons: ['Зима', 'Весна', 'Сакура', 'Літо', 'Осінь'],
      over: (s: number, b: number) => `Кінець. Рахунок ${s}, рекорд ${b}`,
      won: (s: number, b: number) => `Перемога. Рахунок ${s}, рекорд ${b}`,
      resume: (season: string, s: number) => `Продовження: ${season}, рахунок ${s}`,
    });
  </script>
</Base>
