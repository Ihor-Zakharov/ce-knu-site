---
// Звичайні сторінки чинного сайту: дослідження, НМЗ, документи, випускники, навчання.
// Над повним текстом — короткі структуровані блоки (досягнення й напрями, картки випускників, групи посилань);
// сам текст — структурована проза: розділи з лініями, рядки-файли, роки публікацій. Зміст сторінок не змінюється.
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Mascot from '../../../components/Mascot.astro';
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import { langOf, url, type Lang } from '../../../lib/i18n';
import { slugOf } from '../../../lib/content';
import { HEROES } from '../../../lib/heroes';
import { ALUMNI } from '../../../lib/home';
import { UI, RESEARCH_FACTS, RESEARCH_DIRS } from '../../../lib/pages';
import kalyta from '../../../assets/images/abiturient/d_kalita.jpg';
import kramov from '../../../assets/images/abiturient/a_kramov.jpg';
import slynko from '../../../assets/images/abiturient/m_slynko.png';
import '../../../styles/pages.css';

export async function getStaticPaths() {
  const SKIP = ['index', 'personas', 'entrant', 'stateholders'];   // мають власні шаблони
  const all = await getCollection('pages');
  return all.filter(p => !SKIP.includes(slugOf(p.id)) && !slugOf(p.id).includes('/')).map(p => {
    const lang = p.id.split('/')[0] as Lang;
    return { params: { lang: lang === 'en' ? 'en' : undefined, page: slugOf(p.id) }, props: { entry: p } };
  });
}
const { entry } = Astro.props;
const lang = langOf(Astro.params.lang);
const kind = Astro.params.page as string;
const u = UI[lang];
const { Content, headings } = await render(entry);
const toc = headings.filter(h => h.depth === 2);
const docText = entry.data.title + ' · ' + toc.map(h => h.text).join(' · ');
const PHOTOS = { d_kalita: kalyta, a_kramov: kramov, m_slynko: slynko } as const;
const mark = (c: string) => c.replace(/\s+(Inc\.|LLC|Ltd\.?)$/, '');

// «Навчання»: кожна група посилань (жирний підпис + список) — окрема картка
const groups = kind === 'studying'
  ? (entry.rendered?.html ?? '').split(/(?=<p><strong>)/).map(s => s.trim()).filter(Boolean).map(s => {
      const m = s.match(/^<p><strong>([\s\S]*?)<\/strong>\s*<\/p>([\s\S]*)$/);
      return m ? { title: m[1].replace(/:\s*$/, ''), body: m[2] } : { title: '', body: s };
    })
  : [];
// дослідницька група — вкладена сторінка розділу «Дослідження»
const group = kind === 'research' ? await getEntry('pages', `${lang}/research/llm-memory-group`) : undefined;
const proseKind = { documents: 'prose--files', 'medu-guide': 'prose--books', graduates: 'prose--people' }[kind] ?? '';
---
<Base lang={lang} title={entry.data.title} description={HEROES[kind]?.lead[lang] ?? entry.data.description} og={kind} crumbs={[]}>
  <PageHero lang={lang} title={entry.data.title} kind={kind} text={docText} />

  {kind === 'research' && (
    <section class="section pg-intro" aria-labelledby="pg-facts">
      <div class="wrap">
        <p class="eyebrow pg-eyebrow" id="pg-facts">{u.facts}</p>
        <ul class="pg-facts" role="list">
          {RESEARCH_FACTS[lang].map(f => <li><b>{f.value}</b><span>{f.label}</span></li>)}
        </ul>
        <div class="pg-split">
          <div>
            <p class="eyebrow pg-eyebrow">{u.dirs}</p>
            <ol class="pg-dirs" role="list">{RESEARCH_DIRS[lang].map((d, i) => <li><span class="pg-dirs__n">{String(i + 1).padStart(2, '0')}</span>{d}</li>)}</ol>
          </div>
          {group && (
            <a class="pg-group" href={url(lang, '/research/llm-memory-group/')}>
              <span class="eyebrow pg-eyebrow">{u.group}</span>
              <b>{group.data.title}</b>
              <span class="arrow-link">{u.groupMore} <svg width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></span>
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  {kind === 'graduates' && (
    <section class="section pg-intro" aria-labelledby="pg-alumni">
      <div class="wrap">
        <p class="eyebrow pg-eyebrow" id="pg-alumni">{u.alumni}</p>
        <ul class="pg-alumni" role="list">
          {ALUMNI[lang].map(a => { const ph = a.photo && PHOTOS[a.photo as keyof typeof PHOTOS]; return (
            <li>
              <a class="pg-alum" href={a.anchor ? `#${a.anchor}` : undefined}>
                {ph && <span class="pg-alum__ph"><Image src={ph} width={160} alt="" loading="lazy" /></span>}
                <span class="pg-alum__mark">{mark(a.company)}</span>
                <b>{a.who}</b>
                <span class="pg-alum__role">{a.role}</span>
                <span class="arrow-link pg-alum__go">{u.story} <svg class="pg-down" width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></span>
              </a>
            </li>
          ); })}
        </ul>
      </div>
    </section>
  )}

  <section class="section pg-body">
    {toc.length > 2 && (
      <nav class="wrap pg-chips" aria-label={u.toc}>
        <ul role="list">{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </nav>
    )}
    <div class="wrap page">
      {kind === 'studying' ? (
        <div class="pg-groups">
          {groups.map(g => (
            <article class="pg-card">
              {g.title && <h2 class="pg-card__t">{g.title}</h2>}
              <div class="prose pg-card__body" set:html={g.body} />
            </article>
          ))}
        </div>
      ) : (
        <article class={`prose pg-prose ${proseKind}`}>
          {(kind === 'research' || kind === 'graduates') && <p class="eyebrow pg-eyebrow pg-full">{u.full}</p>}
          <Content />
        </article>
      )}
      {toc.length > 2 && (
        <nav class="page__toc" aria-label={u.toc}>
          <p class="eyebrow">{u.toc}</p>
          <ul class="toc mt-s">{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </nav>
      )}
      <aside class="page__aside"><Mascot src={entry.data.mascot} alt={entry.data.mascotAlt} /></aside>
    </div>
  </section>
</Base>
