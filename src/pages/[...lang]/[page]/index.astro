---
// Звичайні сторінки чинного сайту: дослідження, НМЗ, документи, випускники, навчання.
// Сторінка — це сам текст, зверстаний як видання кафедри: зміст ліворуч, текст у читабельну міру, маргіналії праворуч.
// Структуру задає Markdown: розділи ##, <!-- sections --> і <!-- fold --> (див. lib/rehype-site.mjs). Зміст сторінок не змінюється.
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { langOf, url, type Lang } from '../../../lib/i18n';
import { slugOf } from '../../../lib/content';
import { HEROES } from '../../../lib/heroes';
import { UI, RESEARCH_AWARDS } from '../../../lib/pages';
import '../../../styles/pages.css';

export async function getStaticPaths() {
  const SKIP = ['index', 'personas', 'entrant', 'stateholders'];   // мають власні шаблони
  const all = await getCollection('pages');
  return all.filter(p => !SKIP.includes(slugOf(p.id)) && !slugOf(p.id).includes('/')).map(p => {
    const lang = p.id.split('/')[0] as Lang;
    return { params: { lang: lang === 'en' ? 'en' : undefined, page: slugOf(p.id) }, props: { entry: p } };
  });
}
const { entry } = Astro.props;
const lang = langOf(Astro.params.lang);
const kind = Astro.params.page as string;
const u = UI[lang];
const { Content, headings } = await render(entry);
const h2 = headings.filter(h => h.depth === 2);
const docText = entry.data.title + ' · ' + h2.map(h => h.text).join(' · ');
// зміст ліворуч — там, де розділи мають назви; у НМЗ роки вже стоять колонкою, тож замість змісту — пошук
const reg = kind === 'documents' || kind === 'medu-guide';
const toc = kind === 'medu-guide' || kind === 'studying' ? [] : h2;
const years = kind === 'medu-guide' ? h2.map(h => h.text) : [];
// дослідницька група — вкладена сторінка розділу «Дослідження»
const group = kind === 'research' ? await getEntry('pages', `${lang}/research/llm-memory-group`) : undefined;
const awards = Object.entries(Object.groupBy(RESEARCH_AWARDS[lang], a => a.year));
const proseKind = { documents: 'prose--files', 'medu-guide': 'prose--books', graduates: 'prose--people', studying: 'prose--plan', research: 'prose--research' }[kind] ?? '';
---
<Base lang={lang} title={entry.data.title} description={HEROES[kind]?.lead[lang] ?? entry.data.description} og={kind} crumbs={[]}>
  <PageHero lang={lang} title={entry.data.title} kind={kind} text={docText} />

  <section class="section pg-body">
    <div class={`wrap pg pg--${kind}`} data-pg>
      {(toc.length > 0 || reg) && (
        <div class="pg-side">
          {reg && (
            <form class="reg" data-reg hidden role="search" aria-label={u.find} data-shown={u.shown} onsubmit="return false">
              <label class="reg__f"><span>{u.find}</span><input type="search" data-reg-q autocomplete="off" placeholder={kind === 'documents' ? u.findDocs : u.findBooks} /></label>
              {years.length > 0 && (
                <label class="reg__f"><span>{u.year}</span>
                  <select data-reg-y><option value="">{u.allYears}</option>{years.map(y => <option value={y}>{y}</option>)}</select>
                </label>
              )}
              <p class="reg__n" aria-live="polite"><span data-reg-n></span> <button type="button" class="reg__reset" data-reg-reset hidden>{u.reset}</button></p>
            </form>
          )}
          {toc.length > 0 && (
            <nav class="pg-toc" aria-label={u.toc}>
              <p class="pg-label">{u.toc}</p>
              <ul class="toc" role="list">{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
            </nav>
          )}
        </div>
      )}
      {toc.length > 0 && (
        <details class="pg-toc-m">
          <summary>{u.toc}<span class="pg-toc-m__n">{toc.length}</span></summary>
          <ul role="list">{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </details>
      )}
      <article class={`prose pg-prose ${proseKind}`} data-reg-list={reg ? '' : undefined}>
        <Content />
        {reg && <p class="reg__empty" data-reg-empty hidden>{u.empty} <button type="button" class="reg__reset" data-reg-reset>{u.reset}</button></p>}
      </article>
      {kind === 'research' && (
        <aside class="pg-margin">
          {group && (
            <a class="pg-group" href={url(lang, '/research/llm-memory-group/')}>
              <span class="pg-label">{u.group}</span>
              <b>{group.data.title}</b>
              <span class="pg-group__more">{u.groupMore} <svg width="16" height="16" aria-hidden="true"><use href="#i-arrow"/></svg></span>
            </a>
          )}
          <div class="pg-awards">
            <p class="pg-label">{u.awards}</p>
            <dl>
              {awards.map(([year, list]) => <div><dt>{year}</dt>{list!.map(a => <dd><b>{a.title}</b><span>{a.who}</span></dd>)}</div>)}
            </dl>
          </div>
        </aside>
      )}
    </div>
  </section>
</Base>

<script>
  import { pages } from '../../../scripts/pages.js';
  pages();
</script>
