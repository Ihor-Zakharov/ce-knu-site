---
import { Image, Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { T, url, langOf, langParams, fmtDate, isoDate, NAV } from '../../lib/i18n';
import { news, page, slugOf } from '../../lib/content';
import { HEROES } from '../../lib/heroes';

export const getStaticPaths = langParams;
const lang = langOf(Astro.params.lang);
const t = T[lang];
const home = (await page(lang, 'index'))!;
const { Content } = await render(home);
const list = await news(lang);
const [lead, ...rest] = list;
const uk = lang === 'uk';
const scopeKeys = [
  { mode: 'sine', label: 'SIN', on: true },
  { mode: 'square', label: '⊓⊔', sr: uk ? 'Меандр' : 'Square wave' },
  { mode: 'am', label: 'AM', title: uk ? 'Амплітудна модуляція' : 'Amplitude modulation' },
  { mode: 'chirp', label: 'CHIRP', title: uk ? 'Лінійна частотна модуляція' : 'Linear frequency sweep' },
];
const CHAN: Record<string, string> = { '/news/': 'news', '/research/': 'research', '/medu-guide/': 'medu-guide', '/entrant/': 'entrant', '/documents/': 'documents', '/graduates/': 'graduates', '/personas/': 'personas', '/stateholders/': 'stateholders' };
---
<Base lang={lang} title={t.dept} description={home.data.description}>
  <section class="ph hero-home">
    <div class="wrap ph__grid">
      <div class="ph__text">
        <p class="ph__eyebrow"><b>{uk ? 'КНУ' : 'KNU'}</b><span class="long">{uk ? 'Факультет радіофізики, електроніки та комп’ютерних систем' : 'Faculty of Radiophysics, Electronics and Computer Systems'}</span><span>{uk ? '· ФРЕКС' : '· FRECS'}</span></p>
        <h1>{(uk ? ['Кафедра', 'комп’ютерної', 'інженерії'] : ['Department', 'of Computer', 'Engineering']).map((w, i) => <><span class="w"><span style={`--i:${i}`}>{i === 1 ? <em>{w}</em> : w}</span></span> </>)}</h1>
        <p class="lead">{uk ? 'Апаратні платформи й системне програмне забезпечення комп’ютерних систем і мереж — від мікропроцесора до суперкомп’ютера.' : 'Hardware platforms and system software of computer systems and networks — from the microprocessor to the supercomputer.'}</p>
        <div class="cta">
          <a class="btn" href={url(lang, '/entrant/')}>{uk ? 'Вступникам' : 'Admission'} <svg class="arr" width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></a>
          <a class="btn btn--line" href={url(lang, '/news/')}>{t.news}</a>
        </div>
      </div>
      <figure class="scope scope-home" aria-label={uk ? 'Демонстраційний сигнал на осцилографі; по променю біжить КІ-Рекс' : 'Demo signal on an oscilloscope; KI-Rex runs along the trace'}>
        <div class="scope__screen">
          <svg viewBox="0 0 1000 667" preserveAspectRatio="none" aria-hidden="true">
            <g class="grat">
              <path d="M100 0V667M200 0V667M300 0V667M400 0V667M600 0V667M700 0V667M800 0V667M900 0V667M0 83H1000M0 167H1000M0 250H1000M0 417H1000M0 500H1000M0 583H1000"/>
              <path class="axis" d="M500 0V667M0 333.5H1000"/>
            </g>
            <path class="trace trace--ghost"/>
            <path class="trace trace--main"/>
          </svg>
          <canvas class="scope-rex" aria-hidden="true"></canvas>
          <div class="scope__hud scope__hud--top"><span>CH1 · <b data-scope-mode>SIN</b></span><span>2,0 V/DIV · 250 µs/DIV</span></div>
          <div class="scope__hud scope__hud--bot"><span>f = <b data-scope-f>{uk ? '0,80 кГц' : '0.80 kHz'}</b></span><span>KI-REX · {uk ? 'ДЕМО-СИГНАЛ' : 'DEMO SIGNAL'}</span></div>
        </div>
        <div class="scope__keys" role="group" aria-label={uk ? 'Форма сигналу' : 'Waveform'}>
          {scopeKeys.map(k => <button type="button" class="key" data-mode={k.mode} aria-pressed={k.on ? 'true' : 'false'} title={k.title}>{k.sr ? <><span aria-hidden="true">{k.label}</span><span class="sr-only">{k.sr}</span></> : k.label}</button>)}
          <span class="sp"></span><span class="scope__auto cap" data-scope-next aria-live="off"></span>
          <button type="button" class="key" data-scope-play aria-pressed="false" aria-label={uk ? 'Пауза' : 'Pause'} title={uk ? 'Пауза' : 'Pause'}><svg aria-hidden="true"><use href="#i-pause"/></svg></button>
        </div>
      </figure>
    </div>
    <div class="wrap">
      <div class="figures mt-l rv">
        <div><b>100</b><span>{uk ? 'місць на 1-й курс бакалаврату' : 'first-year Bachelor’s places'}</span></div>
        <div><b>50</b><span>{uk ? 'місць у магістратурі' : 'Master’s places'}</span></div>
        <div><b>10</b><span>{uk ? 'місць в аспірантурі (PhD)' : 'PhD places'}</span></div>
        <div><b>1991</b><span>{uk ? 'рік, коли почалася підготовка з автоматизації наукових досліджень' : 'the year scientific-research automation training began'}</span></div>
      </div>
    </div>
  </section>

  {lead && (
    <section class="section">
      <div class="wrap">
        <div class="sec-head rv">
          <div><p class="eyebrow">CH 01 · {t.news}</p><h2 class="mt-s">{uk ? 'Що нового на кафедрі' : 'What’s new at the department'}</h2></div>
          <a class="arrow-link" href={url(lang, '/news/')}>{t.allNews} <svg width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        </div>
        <a class="feat rv" href={url(lang, `/posts/${slugOf(lead.id)}/`)}>
          <figure class="plate rv"><div class="plate__f" style="--ar:16/10">{lead.data.cover && <Picture src={lead.data.cover} formats={['avif', 'webp']} alt={lead.data.coverAlt ?? ''} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 56vw" quality={70} />}</div></figure>
          <div>
            <time datetime={isoDate(lead.data.date)}>{fmtDate(lead.data.date, lang)}</time>
            <h3>{lead.data.title}</h3>
            <p>{lead.data.summary}</p>
            <span class="arrow-link mt-m">{t.readMore} <svg width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></span>
          </div>
        </a>
        <div class="cards mt-l">
          {rest.slice(0, 3).map((n, i) => (
            <a class="card rv" style={`--i:${i}`} href={url(lang, `/posts/${slugOf(n.id)}/`)}>
              <figure class="plate"><div class="plate__f">{n.data.cover && <Image src={n.data.cover} alt="" widths={[360, 640]} sizes="(max-width: 640px) 100vw, 33vw" />}</div></figure>
              <time datetime={isoDate(n.data.date)}>{fmtDate(n.data.date, lang)}</time>
              <h3>{n.data.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="h-channels">
    <div class="wrap">
      <div class="sec-head rv"><div><p class="eyebrow">{uk ? 'Канали' : 'Channels'}</p><h2 class="mt-s" id="h-channels">{t.sections}</h2></div></div>
      <ul class="channels">
        {NAV.map((n, i) => { const h = HEROES[CHAN[n.path]]; return (
          <li class="rv" style={`--i:${i % 4}`}><a href={url(lang, n.path)}>
            <span class="ch">{h.ch}</span>
            <b>{n[lang]}</b>
            <span class="d">{h.lead[lang]}</span>
            <svg class="w" viewBox="0 0 120 20" preserveAspectRatio="none" aria-hidden="true"><path d={`M0 10 ${Array.from({ length: 24 }, (_, k) => `L${(k + 1) * 5} ${(10 - 7 * Math.sin((k + 1) * (0.5 + i * 0.18))).toFixed(1)}`).join(' ')}`} pathLength="1"/></svg>
          </a></li>
        ); })}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="h-about">
    <div class="wrap">
      <div class="sec-head rv"><div><p class="eyebrow">{uk ? 'Про кафедру' : 'About'}</p><h2 class="mt-s" id="h-about">{home.data.title}</h2></div></div>
      <div class="page">
        <article class="prose"><Content /></article>
        <aside class="page__aside">
          {home.data.mascot && <figure class="mascot"><Image src={home.data.mascot} alt={home.data.mascotAlt ?? ''} widths={[200, 380]} sizes="190px" /><figcaption>{home.data.mascotAlt}</figcaption></figure>}
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="band rv">
        <div>
          <p class="eyebrow">F7 · {uk ? 'Комп’ютерна інженерія' : 'Computer Engineering'}</p>
          <h3>{uk ? 'Вступайте на кафедру, де фізика стає кодом' : 'Join the department where physics becomes code'}</h3>
        </div>
        <a class="btn" href={url(lang, '/entrant/')}>{uk ? 'Як вступити' : 'How to apply'} <svg class="arr" width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
    </div>
  </section>
</Base>
