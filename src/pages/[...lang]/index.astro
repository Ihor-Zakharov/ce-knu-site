---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { T, url, langOf, langParams } from '../../lib/i18n';
import { page } from '../../lib/content';
import { HISTORY, PARTNERS, PROGRAMS, STACK, PROFILE_TAGS, LAB_PHOTOS, COPY } from '../../lib/home';
import AlumniStrip from '../../components/AlumniStrip.astro';
import lab01 from '../../assets/images/studying/01.jpg';
import lab03 from '../../assets/images/studying/03.jpg';
import lab05 from '../../assets/images/studying/05.jpg';
import ibm1 from '../../assets/images/studying/ibm-1.jpg';

export const getStaticPaths = langParams;
const lang = langOf(Astro.params.lang);
const t = T[lang];
const c = COPY[lang];
const home = (await page(lang, 'index'))!;
const { Content } = await render(home);
const uk = lang === 'uk';
const LAB_IMG = { '01': lab01, '03': lab03, '05': lab05, 'ibm-1': ibm1 } as const;
const MAIL = 'ce.frecs@knu.ua';
const half = STACK[lang].length / 2;
---
<Base lang={lang} title={t.dept} description={c.meta_description} og="home">
  <section class="ph hero-home">
    <div class="wrap ph__grid">
      <div class="ph__text">
        <p class="ph__eyebrow"><b>{uk ? 'КНУ' : 'KNU'}</b><span class="long">{t.faculty}</span><span>{uk ? '· ФРЕКС' : '· FRECS'}</span></p>
        <h1>{(uk ? ['Кафедра', 'комп’ютерної', 'інженерії'] : ['Department', 'of Computer', 'Engineering']).map((w, i) => <><span class="w"><span style={`--i:${i}`}>{i === 1 ? <em>{w}</em> : w}</span></span> </>)}</h1>
        <p class="lead">{c.hero_lead}</p>
        <div class="cta">
          <a class="btn" href={url(lang, '/entrant/')}>{c.hero_cta_primary} <svg class="arr" width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></a>
          <a class="btn btn--line" href={url(lang, '/stateholders/')}>{c.hero_cta_secondary}</a>
        </div>
      </div>
      <div class="inst-wrap">
      <figure class="scope scope-home showcase" aria-label={uk ? 'Вітрина: процесор, пам’ять, логіка, код, мережі, штучний інтелект' : 'Showcase: processor, memory, logic, code, networks, artificial intelligence'}>
        <div class="scope__screen">
          <canvas aria-hidden="true"></canvas>
          <div class="scope__hud scope__hud--top" aria-hidden="true"><span data-sc-tl></span><span data-sc-tr></span></div>
          <div class="scope__hud scope__hud--bot" aria-hidden="true"><span data-sc-bl></span><span data-sc-br></span></div>
        </div>
        <div class="scope__keys">
          <div class="sc-rail" role="group" aria-label={uk ? 'Що показати' : 'What to show'}>
            {(uk ? [['ПРОЦЕСОР'], ['ПАМ’ЯТЬ'], ['ЛОГІКА'], ['КОД'], ['МЕРЕЖІ'], ['ШІ', 'Штучний інтелект']] : [['CPU'], ['MEMORY'], ['LOGIC'], ['CODE'], ['NETWORKS'], ['AI', 'Artificial intelligence']]).map(([k, name], i) => <button type="button" class="key" data-view={i} data-name={k} aria-label={name && `${k}, ${name}`} title={name} aria-pressed={i === 0 ? 'true' : 'false'}>{k}</button>)}
          </div>
          <span class="sp"></span>
          <button type="button" class="key key--auto" data-sc-auto hidden aria-label={uk ? 'Автоперемикання' : 'Auto cycle'} title={uk ? 'Автоперемикання' : 'Auto cycle'}><svg aria-hidden="true"><use href="#i-loop"/></svg><span class="t">{uk ? 'АВТО' : 'AUTO'}</span></button>
          <button type="button" class="key" data-sc-play aria-pressed="false" aria-label={uk ? 'Пауза' : 'Pause'} title={uk ? 'Пауза' : 'Pause'}><svg aria-hidden="true"><use href="#i-pause"/></svg></button>
        </div>
      </figure>
      </div>
    </div>
  </section>

  <AlumniStrip lang={lang} />

  <section class="section hm" aria-labelledby="h-prof">
    <div class="wrap">
      <header class="hm-head rv">
        <p class="eyebrow">F7 · {t.deptShort}</p>
        <h2 class="sec-h2 mt-s" id="h-prof">{c.profiles_title}</h2>
        <p class="lead mt-m">{c.profiles_lead}</p>
      </header>
      <div class="prof rv">
        <ol class="prof__stack" aria-hidden="true">{STACK[lang].map((s, i) => <li class={i < half ? 'hw' : 'sw'}>{s}</li>)}</ol>
        {([['hw', '01', c.profile_hw_title, c.profile_hw_text], ['sw', '02', c.profile_sw_title, c.profile_sw_text]] as const).map(([k, n, h, p]) => (
          <article class={`prof__card prof__card--${k}`}>
            <ol class="prof__mini" aria-hidden="true">{STACK[lang].slice(k === 'hw' ? 0 : half, k === 'hw' ? half : undefined).map(s => <li>{s}</li>)}</ol>
            <p class="prof__n">{n}</p>
            <h3>{h}</h3>
            <p>{p}</p>
            <ul class="tags" role="list">{PROFILE_TAGS[lang][k].map(g => <li>{g}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section hm" aria-labelledby="h-labs">
    <div class="wrap">
      <header class="hm-head hm-head--row rv">
        <div>
          <p class="eyebrow">{uk ? 'Лабораторії' : 'Labs'}</p>
          <h2 class="sec-h2 mt-s" id="h-labs">{c.labs_title}</h2>
        </div>
        <a class="arrow-link" href={url(lang, '/studying/')}>{t.studying} <svg width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </header>
      <ul class="labs" role="list" tabindex="0" aria-label={c.labs_title}>
        {c.labs_items.map((l, i) => (
          <li class="lab rv" style={`--i:${i}`}>
            <div class="lab__ph"><Image src={LAB_IMG[LAB_PHOTOS[i].img]} widths={[360, 560, 760]} sizes="(max-width: 700px) 80vw, (max-width: 1100px) 45vw, 25vw" alt={LAB_PHOTOS[i][lang]} loading="lazy" /></div>
            <h3>{l.name}</h3>
            <p>{l.text}</p>
          </li>
        ))}
      </ul>
      <div class="logos labs__partners rv" aria-label={uk ? 'Академії й партнери' : 'Academies and partners'}>{PARTNERS.map(p => <span>{p}</span>)}</div>
    </div>
  </section>

  <section class="section hm" aria-labelledby="h-progs">
    <div class="wrap">
      <header class="hm-head hm-head--row rv">
        <div>
          <p class="eyebrow">{c.programs_note}</p>
          <h2 class="sec-h2 mt-s" id="h-progs">{c.programs_title}</h2>
        </div>
        <a class="arrow-link" href={url(lang, '/entrant/')}>{uk ? 'Умови вступу' : 'How to apply'} <svg width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </header>
      <ol class="progs" role="list">
        {PROGRAMS[lang].map((p, i) => { const [n, unit] = p.years.split(' '); return (
          <li class="progs__i rv" style={`--i:${i}`}>
            <p class="progs__lvl">{p.level}</p>
            <p class="progs__n">{n}<small>{unit}</small></p>
            <p class="progs__t">{p.title}</p>
            <p class="progs__pl"><b>{p.places}</b> {uk ? 'місць' : 'places'}</p>
          </li>
        ); })}
      </ol>
    </div>
  </section>

  <section class="section hm" aria-labelledby="h-emp">
    <div class="wrap">
      <div class="emp rv">
        <div class="emp__text">
          <p class="eyebrow">{uk ? 'Партнерство' : 'Partnership'}</p>
          <h2 class="sec-h2 mt-s" id="h-emp">{c.employers_title}</h2>
          <p class="lead mt-m">{c.employers_text}</p>
          <div class="emp__cta">
            <a class="btn" href={`mailto:${MAIL}`}><svg width="18" height="18" aria-hidden="true"><use href="#i-mail"/></svg> {c.employers_cta}</a>
            <a class="arrow-link" href={url(lang, '/stateholders/')}>{uk ? 'Що вміють випускники' : 'What graduates know'} <svg width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></a>
          </div>
        </div>
        <ul class="tags tags--lg" role="list" aria-label={uk ? 'Знання випускників' : 'Graduate skills'}>{c.employers_skills.map(s => <li>{s}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section hm" aria-labelledby="h-history">
    <div class="wrap">
      <header class="hm-head rv">
        <p class="eyebrow">{uk ? 'Хронологія' : 'Timeline'}</p>
        <h2 class="sec-h2 mt-s" id="h-history">{c.history_title}</h2>
        <p class="lead mt-m">{c.history_lead}</p>
      </header>
      <ol class="tl rv" role="list" tabindex="0" aria-label={c.history_title}>
        {HISTORY[lang].map((h, i) => <li style={`--i:${i}`}><time>{h.y}</time><b>{h.t}</b></li>)}
      </ol>
    </div>
  </section>

  <section class="section section--tight hm" aria-labelledby="h-about">
    <div class="wrap">
      <details class="more">
        <summary><span class="eyebrow">{uk ? 'Про кафедру' : 'About'}</span><h2 id="h-about">{c.about_toggle}</h2><span class="more__ico" aria-hidden="true"></span></summary>
        <div class="page more__body">
          <article class="prose"><Content /></article>
        </div>
      </details>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="band rv">
        <div>
          <p class="eyebrow">{c.band_eyebrow}</p>
          <h3>{c.band_title}</h3>
        </div>
        <a class="btn" href={url(lang, '/entrant/')}>{c.band_cta} <svg class="arr" width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
    </div>
  </section>
</Base>
