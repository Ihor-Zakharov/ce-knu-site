---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import { T, url, langOf, langParams, fmtDate, isoDate } from '../../../lib/i18n';
import { news, slugOf, photo } from '../../../lib/content';
import { HEROES } from '../../../lib/heroes';
import NewsArt from '../../../components/NewsArt.astro';

export const getStaticPaths = langParams;
const lang = langOf(Astro.params.lang);
const t = T[lang];
const list = await news(lang);
const years = [...new Set(list.map(n => n.data.date.getUTCFullYear()))];
const msgs = [lang === 'uk' ? 'НОВИНИ' : 'NEWS', '{today}'];   // {today} — сьогоднішня дата, підставляє браузер
---
<Base lang={lang} title={t.news} description={HEROES.news.lead[lang]} og="news" crumbs={[]}>
  <PageHero lang={lang} title={t.news} kind="news" data={{ msgs: JSON.stringify(msgs) }}
    meta={[`<b>${list.length}</b> ${t.newsCount(list.length).replace(/^\d+ /, '')}`, `${years.at(-1)}–${years[0]}`, `<a href="${url(lang, '/rss.xml')}">RSS</a>`]} />
  <section class="section">
    <div class="wrap page">
      <div class="page__main">
      <nav class="years" aria-label={t.year}>
        {years.map(y => <a class="chip" href={`#y${y}`}>{y} <span class="n">{list.filter(n => n.data.date.getUTCFullYear() === y).length}</span></a>)}
      </nav>
      {years.map(y => (
        <section aria-labelledby={`y${y}`}>
          <h2 class="year-h" id={`y${y}`}>{y}</h2>
          <div>
            {list.filter(n => n.data.date.getUTCFullYear() === y).map(n => (
              <a class="newsrow" href={url(lang, `/posts/${slugOf(n.id)}/`)}>
                <time datetime={isoDate(n.data.date)}>{fmtDate(n.data.date, lang)}</time>
                <div><h3>{n.data.title}</h3><p>{n.data.summary}</p></div>
                <span class="thumb">{photo(n) ? <Image src={photo(n)!} alt="" width={192} height={144} fit="cover" /> : <NewsArt slug={slugOf(n.id)} small />}</span>
                <svg width="20" height="20" aria-hidden="true"><use href="#i-arrow"/></svg>
              </a>
            ))}
          </div>
        </section>
      ))}
      </div>
    </div>
  </section>
</Base>
