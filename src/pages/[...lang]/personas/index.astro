---
// Персоналії: групи за посадами (як на чинному сайті), у кожній — сітка карток «фото · ім’я · посада»;
// згори — алфавітний покажчик-якорі (перша людина на кожну літеру отримує #az-<літера>).
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import { T, url, langOf, langParams } from '../../../lib/i18n';
import { people, page, slugOf, initial, ALPHABET } from '../../../lib/content';
import { HEROES } from '../../../lib/heroes';
import '../../../styles/lists.css';

export const getStaticPaths = langParams;
const lang = langOf(Astro.params.lang);
const t = T[lang];
const meta = (await page(lang, 'personas'))!;
const all = (await people(lang)).filter(p => !p.data.unlisted);
const groups = [...new Set(all.map(p => p.data.group))];
const firstOf = new Map<string, string>();
[...all].sort((a, b) => a.data.name.localeCompare(b.data.name, lang)).forEach(p => { const L = initial(p.data.name, lang); if (!firstOf.has(L)) firstOf.set(L, slugOf(p.id)); });
const anchorFor = (slug: string) => [...firstOf].filter(([, s]) => s === slug).map(([L]) => `az-${L}`)[0];
const letters = ALPHABET[lang];
const initials = (n: string) => n.split(/\s+/).slice(0, 2).map(w => w[0]).join('');
---
<Base lang={lang} title={meta.data.title} description={HEROES.personas.lead[lang]} og="personas" crumbs={[]}>
  <PageHero lang={lang} title={meta.data.title} kind="personas" meta={[`<b>${all.length}</b> ${t.peopleCount(all.length).replace(/^\d+ /, '')}`, `${groups.length} ${lang === 'uk' ? 'груп' : 'groups'}`]} />
  <section class="section pl">
    <div class="wrap">
      <nav class="az-bar pl-az" aria-label={t.azLabel}>
        {letters.map(L => firstOf.has(L) ? <a href={`#az-${L}`} title={`${t.azJump} ${L}`}>{L}</a> : <span aria-hidden="true">{L}</span>)}
      </nav>
      {groups.map(g => {
        const ps = all.filter(p => p.data.group === g);
        return (
          <section class="pl-group" aria-labelledby={`g-${ps[0].data.groupOrder}`}>
            <header class="pl-group__h"><h2 id={`g-${ps[0].data.groupOrder}`}>{g}</h2><span>{t.peopleCount(ps.length)}</span></header>
            <ul class="pl-grid" role="list">
              {ps.map(p => {
                const slug = slugOf(p.id), id = anchorFor(slug);
                const inner = <>
                  <span class="pl-ph">{p.data.photo ? <Image src={p.data.photo} alt="" width={240} height={300} fit="cover" /> : <span class="pl-ini" aria-hidden="true">{initials(p.data.name)}</span>}</span>
                  <span class="pl-txt"><span class="pl-n">{p.data.name}</span>{p.data.role && <span class="pl-r">{p.data.role}</span>}</span>
                </>;
                return <li>{p.data.legacy
                  ? <a class="pl-card" id={id} href={url(lang, `/personas/${slug}/`)}>{inner}</a>
                  : <div class="pl-card" id={id}>{inner}</div>}</li>;
              })}
            </ul>
          </section>
        );
      })}
    </div>
  </section>
</Base>
