---
// Новина: заголовок і рядок даних (дата, час читання), обкладинка в межах колонки тексту (логотипи — цілими),
// текст ~68 знаків у рядку, ліворуч — коротка довідка й «Усі новини», унизу — попередня й наступна новини картками.
import { Picture, getImage } from 'astro:assets';
import { articleLd } from '../../../../lib/seo';
import Base from '../../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { T, url, langOf, fmtDate, isoDate, type Lang } from '../../../../lib/i18n';
import { news, slugOf, photo } from '../../../../lib/content';
import NewsArt from '../../../../components/NewsArt.astro';
import '../../../../styles/lists.css';

export async function getStaticPaths() {
  const all = await getCollection('news', e => !e.data.draft);
  return all.map(n => {
    const lang = n.id.split('/')[0] as Lang;
    return { params: { lang: lang === 'en' ? 'en' : undefined, slug: slugOf(n.id) }, props: { entry: n } };
  });
}
const { entry } = Astro.props;
const lang = langOf(Astro.params.lang);
const t = T[lang];
const uk = lang === 'uk';
const { Content } = await render(entry);
const list = await news(lang);
const i = list.findIndex(n => n.id === entry.id);
const newer = list[i - 1], older = list[i + 1];
const words = entry.data.title.split(/\s+/);
const cover = photo(entry);
// обкладинка, що є й на початку тексту (так було на чинному сайті), — не дублюємо: показуємо лише в тексті
const coverFile = entry.data.cover ? (entry.data.cover.src.split('/').pop() ?? '').split('.')[0] : '';
const inBody = !!coverFile && (entry.body ?? '').includes(coverFile + '.');
const ogCover = cover && (await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 })).src;
const ld = articleLd({ lang, title: entry.data.title, description: entry.data.summary, path: `/posts/${Astro.params.slug}/`, date: entry.data.date, image: ogCover, site: Astro.site! });
// час читання: ~180 слів за хвилину, щонайменше 1 хв
const nWords = (entry.body ?? '').replace(/!\[[^\]]*\]\([^)]*\)|<[^>]+>|[#*_>`[\]()]/g, ' ').split(/\s+/).filter(Boolean).length;
const mins = Math.max(1, Math.round(nWords / 180));
const read = uk ? `${mins} хв читання` : `${mins} min read`;
---
<Base lang={lang} title={entry.data.title} description={entry.data.summary} type="article" og={`posts/${Astro.params.slug}`} ogFallback="news" published={entry.data.date} crumbs={[{ name: t.news, path: '/news/' }]} jsonld={[ld]}>
  <article class="np">
    <header class="ph np-hd">
      <div class="wrap">
        <nav aria-label={uk ? 'Навігаційний ланцюжок' : 'Breadcrumbs'}>
          <ol class="crumbs"><li><a href={url(lang, '/')}>{t.home}</a></li><li><a href={url(lang, '/news/')}>{t.news}</a></li><li aria-current="page">{fmtDate(entry.data.date, lang)}</li></ol>
        </nav>
        <div class="np-head">
          <p class="ph__eyebrow"><b>{uk ? 'Новини' : 'News'}</b><span>· <time datetime={isoDate(entry.data.date)}>{fmtDate(entry.data.date, lang)}</time></span></p>
          <h1 class="post-title">{words.map((w, k) => <><span class="w"><span style={`--i:${Math.min(k, 12)}`}>{w}</span></span>{' '}</>)}</h1>
          <p class="np-meta">{read}</p>
        </div>
      </div>
    </header>
    <div class="section np-body">
      <div class="wrap np-grid">
        <aside class="np-aside">
          <dl>
            <div><dt>{t.published}</dt><dd><time datetime={isoDate(entry.data.date)}>{fmtDate(entry.data.date, lang)}</time></dd></div>
            <div><dt>{uk ? 'Читання' : 'Reading'}</dt><dd>{read}</dd></div>
          </dl>
          <a class="arrow-link np-back" href={url(lang, '/news/')}><svg width="16" height="16" aria-hidden="true"><use href="#i-left"/></svg>{uk ? 'Усі новини' : 'All news'}</a>
        </aside>
        <div class="np-main">
          {inBody ? null : cover ? (
            <figure class="np-cover"><Picture src={cover} formats={['avif', 'webp']} alt={entry.data.coverAlt ?? ''} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 760px" quality={68} loading="eager" fetchpriority="high" /></figure>
          ) : (
            <figure class="np-cover np-cover--art" aria-hidden="true"><NewsArt slug={Astro.params.slug!} /></figure>
          )}
          <div class="prose np-prose"><Content /></div>
        </div>
      </div>
      <nav class="wrap np-pn" aria-label={uk ? 'Інші новини' : 'More news'}>
        {older ? <a class="np-pn__i" href={url(lang, `/posts/${slugOf(older.id)}/`)}><span class="np-pn__k"><svg width="14" height="14" aria-hidden="true"><use href="#i-left"/></svg>{t.prev}</span><b>{older.data.title}</b><time datetime={isoDate(older.data.date)}>{fmtDate(older.data.date, lang)}</time></a> : <span></span>}
        {newer ? <a class="np-pn__i np-pn__i--next" href={url(lang, `/posts/${slugOf(newer.id)}/`)}><span class="np-pn__k">{t.next}<svg width="14" height="14" aria-hidden="true"><use href="#i-right"/></svg></span><b>{newer.data.title}</b><time datetime={isoDate(newer.data.date)}>{fmtDate(newer.data.date, lang)}</time></a> : <span></span>}
      </nav>
    </div>
  </article>
</Base>
