---
import { Picture, getImage } from 'astro:assets';
import { articleLd } from '../../../../lib/seo';
import Base from '../../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { T, url, langOf, fmtDate, isoDate, type Lang } from '../../../../lib/i18n';
import { news, slugOf } from '../../../../lib/content';

export async function getStaticPaths() {
  const all = await getCollection('news', e => !e.data.draft);
  return all.map(n => {
    const lang = n.id.split('/')[0] as Lang;
    return { params: { lang: lang === 'en' ? 'en' : undefined, slug: slugOf(n.id) }, props: { entry: n } };
  });
}
const { entry } = Astro.props;
const lang = langOf(Astro.params.lang);
const t = T[lang];
const { Content } = await render(entry);
const list = await news(lang);
const i = list.findIndex(n => n.id === entry.id);
const newer = list[i - 1], older = list[i + 1];
const words = entry.data.title.split(/\s+/);
const ogCover = entry.data.cover && (await getImage({ src: entry.data.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 })).src;
const ld = articleLd({ lang, title: entry.data.title, description: entry.data.summary, path: `/posts/${Astro.params.slug}/`, date: entry.data.date, image: ogCover, site: Astro.site! });
---
<Base lang={lang} title={entry.data.title} description={entry.data.summary} type="article" image={entry.data.cover} og="news" published={entry.data.date} crumbs={[{ name: t.news, path: '/news/' }]} jsonld={[ld]}>
  <article>
    <header class="ph post-hd">
      <div class="wrap">
        <nav aria-label={lang === 'uk' ? 'Навігаційний ланцюжок' : 'Breadcrumbs'}>
          <ol class="crumbs"><li><a href={url(lang, '/')}>{t.home}</a></li><li><a href={url(lang, '/news/')}>{t.news}</a></li><li aria-current="page">{fmtDate(entry.data.date, lang)}</li></ol>
        </nav>
        <p class="ph__eyebrow mt-m"><b>CH 01</b><time datetime={isoDate(entry.data.date)}>{fmtDate(entry.data.date, lang)}</time></p>
        <h1 class="post-title">{words.map((w, k) => <><span class="w"><span style={`--i:${Math.min(k, 12)}`}>{w}</span></span>{' '}</>)}</h1>
        {entry.data.cover && (
          <figure class="plate post-cover rv">
            <div class="plate__f"><Picture src={entry.data.cover} formats={['avif', 'webp']} alt={entry.data.coverAlt ?? ''} widths={[480, 800, 1200, 1600]} sizes="(max-width: 1320px) 100vw, 1320px" quality={68} loading="eager" fetchpriority="high" /></div></figure>
        )}
      </div>
    </header>
    <div class="section" style="border-top:0;padding-top:0">
      <div class="wrap page">
        <div class="prose"><Content /></div>
        <aside class="page__toc post-meta">
          <dl><dt>{t.published}</dt><dd><time datetime={isoDate(entry.data.date)}>{fmtDate(entry.data.date, lang)}</time></dd></dl>
          <a class="btn btn--line btn--sm" href={url(lang, '/news/')}><svg width="16" height="16" aria-hidden="true"><use href="#i-left"/></svg>{t.back}</a>
        </aside>
      </div>
      <nav class="wrap prevnext mt-l" aria-label={lang === 'uk' ? 'Інші новини' : 'More news'}>
        {older ? <a href={url(lang, `/posts/${slugOf(older.id)}/`)}><span class="meta">← {t.prev}</span><b>{older.data.title}</b></a> : <span></span>}
        {newer ? <a href={url(lang, `/posts/${slugOf(newer.id)}/`)}><span class="meta">{t.next} →</span><b>{newer.data.title}</b></a> : <span></span>}
      </nav>
    </div>
  </article>
</Base>
