---
import Base from '../../layouts/Base.astro';
import { T, url } from '../../lib/i18n';
const e = T.en;
---
<Base lang="en" title={e.notFound} noindex>
  <section class="ph nf">
    <div class="wrap">
      <p class="ph__eyebrow"><b>404</b>NO SIGNAL</p>
      <h1>{e.notFound}</h1>
      <p class="lead">{e.notFoundLead}</p>
      <div class="runner" id="runner" role="application" aria-label="KI-Rex game. Jump: Space or tap. Duck: Down arrow. Pause: P">
        <canvas aria-hidden="true"></canvas>
        <span class="sr-only" data-runner-live aria-live="polite"></span>
      </div>
      <div class="row mt-m"><a class="btn" href={url('en', '/')}>{e.toHome}</a></div>
    </div>
  </section>
  <script>
    import { runner } from '../../scripts/runner.js';
    const el = document.getElementById('runner');
    // рядки гри: keys і touch — рядок керування на екрані, tips — слова підказок; решта — оголошення для екранного читача
    if (el) runner(el, {
      keys: 'Controls: up and down arrows', touch: 'Controls: tap or hold',
      tips: { jump: 'Jump', duck: 'Duck', pad: 'Springboard', orb: 'Jump again' },
      start: 'Go', paused: 'Paused', victory: 'Victory', seasons: ['Winter', 'Spring', 'Sakura', 'Summer', 'Autumn'],
      over: (s: number, b: number) => `Game over. Score ${s}, best ${b}`,
      won: (s: number, b: number) => `Victory. Score ${s}, best ${b}`,
      resume: (season: string, s: number) => `Resuming: ${season}, score ${s}`,
    });
  </script>
</Base>
