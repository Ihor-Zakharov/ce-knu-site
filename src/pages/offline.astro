---
// Сторінка без зв'язку: її віддає service worker, коли мережі немає, а сторінки ще не відвідували. Двомовна, з грою КІ-Рекса.
import Base from '../layouts/Base.astro';
import { url } from '../lib/i18n';
---
<Base lang="uk" title="Немає зв’язку" description="Немає з’єднання з мережею. Відвідані сторінки сайту кафедри доступні й без зв’язку." noindex>
  <section class="ph nf">
    <div class="wrap">
      <p class="ph__eyebrow"><b>OFFLINE</b>NO SIGNAL</p>
      <h1>Немає зв’язку</h1>
      <p class="lead">Сторінки, які ви вже відкривали, доступні й без мережі. Поки зв’язок повертається, пограйте з КІ-Рексом.</p>
      <p class="lead" lang="en" style="font-size:15px">You are offline. Pages you have already opened still work. Play with KI-Rex while the connection comes back.</p>
      <div class="runner" id="runner" role="application" aria-label="Гра з КІ-Рексом. Стрибок: пробіл або дотик. Пригнутися: стрілка вниз. Пауза: P">
        <canvas aria-hidden="true"></canvas>
        <span class="sr-only" data-runner-live aria-live="polite"></span>
      </div>
      <div class="row mt-m"><a class="btn" href={url('uk', '/')}>На головну</a><button type="button" class="btn btn--line" onclick="location.reload()">Спробувати ще раз</button></div>
    </div>
  </section>
  <script>
    import { runner } from '../scripts/runner.js';
    const el = document.getElementById('runner');
    // рядки гри: keys і touch — рядок керування на екрані, tips — слова підказок; решта — оголошення для екранного читача
    if (el) runner(el, {
      keys: 'Керування: стрілки вгору і вниз', touch: 'Керування: торкання або утримання',
      tips: { jump: 'Стрибок', duck: 'Пригнутися', pad: 'Пружина', orb: 'Ще стрибок' },
      start: 'Гра', paused: 'Пауза', victory: 'Перемога', seasons: ['Зима', 'Весна', 'Сакура', 'Літо', 'Осінь'],
      over: (s: number, b: number) => `Кінець. Рахунок ${s}, рекорд ${b}`,
      won: (s: number, b: number) => `Перемога. Рахунок ${s}, рекорд ${b}`,
      resume: (season: string, s: number) => `Продовження: ${season}, рахунок ${s}`,
    });
  </script>
</Base>
