---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { toLang, useTranslations } from '@/i18n/ui';

const t = useTranslations(toLang(Astro.currentLocale));
---

<BaseLayout>
  <section class="intro">
    <h1>{t('home.title')}</h1>
    <p>
      {t('home.lead')} <a href="https://ce.knu.ua/">{t('home.currentSite')}</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: var(--space-4);
    max-width: var(--size-prose);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  p {
    font-size: var(--text-lg);
  }
</style>
